{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "install-skill.json",
 "title": "rosettex install-skill --json",
 "allOf": [
  {
   "$ref": "envelope.json"
  },
  {
   "if": {
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "ok"
    ]
   },
   "then": {
    "required": [
     "locations"
    ]
   }
  }
 ],
 "properties": {
  "locations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "path",
     "status"
    ]
   }
  }
 }
}
