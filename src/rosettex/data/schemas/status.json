{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "status.json",
 "title": "rosettex status --json",
 "allOf": [
  {
   "$ref": "envelope.json"
  },
  {
   "if": {
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "ok"
    ]
   },
   "then": {
    "required": [
     "stage",
     "translated",
     "total"
    ]
   }
  }
 ],
 "properties": {
  "stage": {
   "enum": [
    "fetched",
    "prepared",
    "translating",
    "checked",
    "building",
    "needs_repair",
    "built"
   ]
  },
  "translated": {
   "type": "integer",
   "minimum": 0
  },
  "total": {
   "type": "integer",
   "minimum": 0
  }
 },
 "description": "ok is true whenever the query succeeded (exit 0), also with state partial (stage building: a budget-stopped build; next_argv is that build's own argv) or not_started."
}
